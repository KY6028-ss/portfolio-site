<h1>お知らせ</h1>
<div style="display: flex; flex-direction: column; gap: 15px;">
  <% @announcements.each do |announcement| %>
    <div style="border-bottom: 1px solid #eee; padding-bottom: 10px;">
      <time style="color: #666; font-size: 0.9rem;"><%= announcement.published_at.strftime('%Y-%m-%d') %></time>
      <h2 style="margin: 5px 0; font-size: 1.2rem;"><%= link_to announcement.title, announcement_path(announcement), style: "color: #333; text-decoration: none;" %></h2>
    </div>
  <% end %>
</div>