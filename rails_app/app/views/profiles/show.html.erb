<% content_for :title, "このサイトについて" %>

<h1>このサイトについて</h1>
<h2>プロフィール</h2>
<p><strong>名前:</strong> <%= @profile.name %></p>
<section>
  <h3>自己紹介</h3>
  <div class="prose"><%= simple_format(@profile.bio) %></div>
</section>
<section>
  <h3>サイトの趣旨</h3>
  <div class="prose"><%= simple_format(@profile.site_description) %></div>
</section>

<hr>

<h2>🤖 AIアシスタントに質問する</h2>
<p>ポートフォリオやスキルについて、AIが直接お答えします。</p>

<%= form_with url: chat_profile_path, method: :post, local: true do |form| %>
  <div class="chat-form">
    <%= form.label :message, "AIへの質問", class: "visually-hidden" %>
    <%= form.text_field :message, value: @user_message, placeholder: "例: あなたのスキルを教えてください", class: "field" %>
    <%= form.submit "質問する", class: "btn btn--primary" %>
  </div>
<% end %>

<% if @ai_reply.present? %>
  <div class="ai-reply">
    <strong>🤖 AIからの回答:</strong>
    <p class="ai-reply__body"><%= @ai_reply %></p>
  </div>
<% end %>
