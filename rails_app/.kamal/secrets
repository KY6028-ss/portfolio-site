# Kamal シークレット解決ファイル
# ------------------------------------------------------------------
# ここには「値」ではなく「環境変数や取得コマンドへの参照」だけを書きます。
# 実際の値は実行環境の環境変数（または secrets マネージャ）から渡してください。
# 例（デプロイ実行前にシェルで）:
#   export KAMAL_REGISTRY_PASSWORD=<Docker Hub アクセストークン>
#   export GEMINI_API_KEY=<Gemini APIキー>
#   # RAILS_MASTER_KEY は config/master.key から自動取得（下記）

# コンテナレジストリのパスワード/トークン
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails 資格情報の復号キー（config/master.key の中身）
# master.key が無い場合は EDITOR=vi bin/rails credentials:edit で生成すること
RAILS_MASTER_KEY=$(cat config/master.key)

# python_ai（RAG）用の Gemini APIキー
GEMINI_API_KEY=$GEMINI_API_KEY
