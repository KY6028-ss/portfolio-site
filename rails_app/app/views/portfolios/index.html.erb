<h1>ポートフォリオ / 実績</h1>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
  <% @portfolios.each do |portfolio| %>
    <div style="border: 1px solid #ddd; padding: 15px; border-radius: 8px; background: #fff;">
      <h2 style="margin-top: 0;"><%= link_to portfolio.title, portfolio_path(portfolio) %></h2>
      <p><%= truncate(portfolio.description, length: 100) %></p>
      <% if portfolio.url.present? %>
        <%= link_to "詳細を見る", portfolio.url, target: "_blank", style: "color: #007bff; text-decoration: none;" %>
      <% end %>
    </div>
  <% end %>
</div>