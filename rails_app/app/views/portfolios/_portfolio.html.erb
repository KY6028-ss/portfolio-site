<article class="card">
  <h2 class="card__title"><%= link_to portfolio.title, portfolio_path(portfolio) %></h2>
  <p class="prose"><%= truncate(portfolio.description, length: 100) %></p>
  <% if portfolio.url.present? %>
    <%= link_to "詳細を見る", portfolio.url, target: "_blank", rel: "noopener" %>
  <% end %>
</article>
