<% content_for :title, @blog.title %>
<% content_for :description, truncate(strip_tags(@blog.content), length: 120) %>

<article>
  <h1><%= @blog.title %></h1>
  <p><%= format_date(@blog.published_at) %></p>
  <div class="prose">
    <%= markdown(@blog.content) %>
  </div>
  <%= link_to "記事一覧に戻る", blogs_path %>
</article>
